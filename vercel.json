{
  "version": 2,
  "buildCommand": "cd ml-evaluator/frontend && npm install && npm run build",
  "outputDirectory": "ml-evaluator/frontend/dist",
  "functions": {
    "api/index.py": {
      "runtime": "python3.9",
      "memory": 3008,
      "maxDuration": 120
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}





