{
  "version": 2,
  "buildCommand": "cd ml-evaluator/frontend && npm install && npm run build",
  "outputDirectory": "ml-evaluator/frontend/dist",
  "env": {
    "VITE_API_URL": ""
  },
  "functions": {
    "api.py": {
      "runtime": "python3.9"
    }
  },
  "rewrites": [
    {
      "source": "/evaluate",
      "destination": "/api"
    },
    {
      "source": "/health",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}


