{
  "version": 2,
  "buildCommand": "cd ml-evaluator/frontend && npm install && npm run build",
  "outputDirectory": "ml-evaluator/frontend/dist",
  "env": {
    "VITE_API_URL": "@api_url"
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/index.py": {
      "runtime": "python3.11",
      "memory": 3008,
      "maxDuration": 60
    }
  }
}

